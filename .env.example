# ---- Khóa AI: có thể điền nhiều khóa, ngăn cách bằng dấu phẩy. Game tự luân phiên và chuyển nhà cung cấp
# khi một khóa hết hạn mức. Hết sạch khóa thì game vẫn chơi được bằng kịch bản offline. ----
GEMINI_API_KEYS="KEY_GEMINI_1,KEY_GEMINI_2"
# GEMINI_API_KEY="MY_GEMINI_API_KEY"          # (cũ) một khóa duy nhất vẫn dùng được
OPENAI_API_KEYS=""
ANTHROPIC_API_KEYS=""

# Thứ tự ưu tiên nhà cung cấp (mặc định: gemini,openai,anthropic)
# AI_PROVIDER_ORDER="gemini,openai,anthropic"

# Tùy chọn đổi model
# GEMINI_MODEL="gemini-3.8-flash"
# OPENAI_MODEL="gpt-4o-mini"
# ANTHROPIC_MODEL="claude-haiku-5-5"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
